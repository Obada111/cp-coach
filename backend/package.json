{
  "name": "cp-coach-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend for Personal Competitive Programming Coach",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:verify": "tsx src/cli/database.ts verify",
    "db:backup": "tsx src/cli/database.ts backup",
    "db:restore": "tsx src/cli/database.ts restore",
    "db:migrate": "tsx src/cli/database.ts migrate",
    "db:claim": "tsx src/cli/database.ts claim",
    "db:rollback": "tsx src/cli/database.ts rollback",
    "db:migrations": "tsx src/cli/database.ts migrations"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
