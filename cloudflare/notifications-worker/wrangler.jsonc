{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cp-coach-notifications",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 10
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cp-coach-notifications",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "VAPID_SUBJECT": "mailto:admin@cp-coach.app"
  }
}
