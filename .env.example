# Local backend environment configuration
PORT=3001
HOST=127.0.0.1
DB_DIR=./data
PUBLIC_MODE=false
TIMEZONE=Asia/Hebron
CODEFORCES_REQUEST_TIMEOUT_MS=10000

# Private remote deployments may set a bearer token for the legacy API.
# This is server-side only; never expose it through a VITE_* variable.
COACH_API_TOKEN=

# Public deployment (Render):
# PUBLIC_MODE=true
# DB_DIR=/tmp/cp_coach
# CORS_ORIGINS=https://your-frontend.vercel.app
# ALLOW_VERCEL_PREVIEWS=true
# COACH_ADMIN_TOKEN=optional-strong-admin-token
