# Public deployment reference (Render backend + Vercel frontend)
# Copy values into hosting dashboards only after the release blockers in
# docs/notifications-deployment-checklist.md are resolved. Never commit secrets.

# Render backend environment
NODE_ENV=production
PUBLIC_MODE=true
HOST=0.0.0.0
# Render provides PORT automatically. Production public mode refuses to start
# without SUPABASE_URL and SUPABASE_ANON_KEY.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Zero-Cost Free-Tier Deployment ($0.00/month):
# Render Free Web Service (ephemeral /tmp cache) + Supabase PostgreSQL (durable source of truth)
DB_DIR=/tmp/cp_coach
DB_BACKUP_DIR=/tmp/cp_coach/backups
ALLOW_EPHEMERAL_DB_CACHE=true
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_RETENTION=7
DB_BACKUP_ON_STARTUP=false
# Optional: only needed to reassign legacy client-owned profiles or perform
# an administrator-assisted claim. Store it as a Render secret.
LEGACY_MIGRATION_SECRET=
TIMEZONE=Asia/Hebron
CODEFORCES_REQUEST_TIMEOUT_MS=10000

# Server-only Cloudflare Worker bridge. Never add these to Pages.
CLOUDFLARE_NOTIFICATIONS_URL=https://cp-coach-notifications.<account-subdomain>.workers.dev
CLOUDFLARE_NOTIFICATIONS_API_SECRET=
VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY belongs only in the Cloudflare Worker secret store.
# VAPID_SUBJECT is configured on the Cloudflare Worker.

# Set to the exact Vercel production origin. If omitted in production public
# mode, only the built-in default origin is allowed.
CORS_ORIGINS=https://your-production-domain.vercel.app

# Optional: enables the private legacy /api/admin routes. Leave unset to
# disable them (they return 404).
COACH_ADMIN_TOKEN=

# Optional cache TTLs (milliseconds)
SUBMISSIONS_TTL_MS=300000
PROFILE_TTL_MS=300000
RATING_TTL_MS=3600000
CONTESTS_TTL_MS=7200000
PROBLEMSET_TTL_MS=86400000
ACTIVE_WINDOW_MS=1800000

# Vercel frontend build environment
# VITE_PUBLIC_MODE=true
# VITE_API_BASE_URL=https://your-render-service.onrender.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Do NOT add any backend/Worker secret to Vercel.

# Render backend social features (server-only; use Render secret values)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# DATABASE_URL=postgresql://...@...pooler.supabase.com:6543/postgres?sslmode=require
# CODEFORCES_CREDENTIAL_ENCRYPTION_KEY=<base64-encoded-32-byte-secret>
